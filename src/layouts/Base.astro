---
import '@fontsource-variable/unbounded/wght.css';
import '@fontsource-variable/onest/wght.css';
import '../styles/global.css';
import { site, prices, langs, pagePath, type Lang, type Page } from '../data/site';
import { dicts } from '../data/i18n';

interface Props {
  lang: Lang;
  page?: Page;
  title?: string;
  desc?: string;
  faq?: { q: string; a: string }[];
  ld?: Record<string, unknown>[];
}
const { lang, page = 'home' } = Astro.props;
const t = dicts[lang];
const title = Astro.props.title ?? t.metaTitle;
const desc = Astro.props.desc ?? t.metaDesc;
const faqItems = Astro.props.faq ?? t.faq.items;
const canonical = new URL(pagePath(page, lang), site.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: site.name,
  description: t.metaDesc,
  url: new URL(pagePath('home', lang), site.url).href,
  telephone: site.phoneHref.replace('tel:', ''),
  email: site.email,
  areaServed: { '@type': 'City', name: 'Warszawa' },
  openingHours: ['Mo-Fr 08:00-20:00', 'Sa 09:00-18:00'],
  priceRange: `${Math.min(...prices.map((p) => p.price))}–${Math.max(...prices.map((p) => p.price))} PLN`,
  knowsLanguage: ['pl', 'en', 'ru', 'uk'],
};
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={dicts[l].htmlLang} href={new URL(pagePath(page, l), site.url).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pagePath(page, 'pl'), site.url).href} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta name="theme-color" content="#F5F5F0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    <script type="application/ld+json" set:html={JSON.stringify(faq)} />
    {(Astro.props.ld ?? []).map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
