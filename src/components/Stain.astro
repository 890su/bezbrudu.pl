---
// Stains are drawn as halftone: dot density is the amount of dirt.
interface Props { kind: number }
const { kind } = Astro.props;
const id = `st${kind}`;

const blobs = [
  'M60 16c23 0 42 17 43 40 1 26-17 48-44 48S15 84 17 57C19 33 37 16 60 16z',
  'M36 32c14-14 41-12 53 4 10 14 6 29 18 39 8 8-2 21-14 15-10-5-14 4-22 12-11 10-31 8-39-6-6-10 2-18-6-28-10-12-2-30 10-36z',
  'M28 42c11-19 47-23 63-9s14 41-4 53-49 12-61-4S20 54 28 42z',
  'M12 74c10-21 35-35 59-39s41 2 37 14-27 15-43 23-28 24-41 20-16-10-12-18z',
  'M24 30c18-10 54-12 70 4s10 46-10 58-56 10-66-8-12-44 6-54z',
  'M20 60c0-22 18-38 40-38s42 16 42 38-20 40-42 40-40-18-40-40z',
  'M18 18h86v86H18z',
];
const mites = [
  [24, 30, 2.2], [40, 22, 1.4], [58, 34, 2.8], [80, 26, 1.6], [96, 40, 2.2], [30, 52, 1.6],
  [50, 58, 3], [72, 50, 1.8], [90, 62, 2.4], [22, 76, 2.6], [42, 84, 1.5], [64, 76, 2.2],
  [86, 86, 1.6], [100, 80, 2.8], [34, 100, 2], [58, 98, 1.6], [78, 104, 2.4], [16, 96, 1.4],
];
---
<svg class="stain" viewBox="0 0 120 120" aria-hidden="true" focusable="false">
  <defs>
    <pattern id={`${id}l`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <circle cx="3.5" cy="3.5" r="1.25" />
    </pattern>
    <pattern id={`${id}h`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <circle cx="3.5" cy="3.5" r="2.45" />
    </pattern>
    <pattern id={`${id}m`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <circle cx="3.5" cy="3.5" r="1.85" />
    </pattern>
  </defs>
  {kind === 0 && (
    <g>
      <path d={blobs[0]} fill={`url(#${id}l)`} />
      <path d={blobs[0]} fill="none" stroke={`url(#${id}h)`} stroke-width="12" />
    </g>
  )}
  {kind === 1 && <path d={blobs[1]} fill={`url(#${id}h)`} />}
  {kind === 2 && (
    <g>
      <path d={blobs[2]} fill={`url(#${id}m)`} />
      <path d="M44 52c8-8 26-8 32 2s-4 22-18 20-22-12-14-22z" fill={`url(#${id}h)`} />
    </g>
  )}
  {kind === 3 && <path d={blobs[3]} fill={`url(#${id}m)`} />}
  {kind === 4 && (
    <g class="stain__hair">
      {[
        'M20 40c6-4 12-2 16 2', 'M44 28c4 5 4 11 1 16', 'M64 40c6-3 12 0 14 5', 'M88 30c2 6 0 11-4 14',
        'M26 66c5 2 8 7 8 12', 'M50 60c6 0 10 4 12 9', 'M76 64c4-4 10-4 14 0', 'M96 58c-2 6-6 9-11 10',
        'M30 92c5-4 11-3 15 1', 'M58 86c3 5 2 11-2 14', 'M82 90c6-1 10 2 12 7', 'M16 54c3 3 3 8 1 12',
      ].map((d) => <path d={d} />)}
    </g>
  )}
  {kind === 5 && (
    <g>
      <path d="M24 74c0-16 16-26 36-26s40 10 40 26-18 30-40 30-36-14-36-30z" fill={`url(#${id}l)`} />
      <path class="stain__waft" d="M44 40c-6-6 6-10 0-16s6-10 0-16 M60 38c-6-6 6-10 0-16s6-10 0-16 M76 40c-6-6 6-10 0-16s6-10 0-16" />
    </g>
  )}
  {kind === 6 && mites.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}
</svg>
