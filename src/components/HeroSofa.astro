---
import type { Dict } from '../data/i18n';
import { promo } from '../data/site';
interface Props { t: Dict }
const { t } = Astro.props;

// Front view of a three-seat sofa in a 600 × 340 drawing space.
// The same shapes are rebuilt in src/scripts/scrub.ts to clip the dirt layer.
const shapes = [
  'M70 178V72a32 32 0 0 1 32-32h396a32 32 0 0 1 32 32v106z',
  'M96 166V71a14 14 0 0 1 14-14h105a14 14 0 0 1 14 14v95z',
  'M235 166V71a14 14 0 0 1 14-14h102a14 14 0 0 1 14 14v95z',
  'M371 166V71a14 14 0 0 1 14-14h105a14 14 0 0 1 14 14v95z',
  'M28 282V152a36 36 0 0 1 72 0v130z',
  'M500 282V152a36 36 0 0 1 72 0v130z',
  'M100 178a8 8 0 0 1 8-8h119a8 8 0 0 1 8 8v54H100z',
  'M235 178a8 8 0 0 1 8-8h114a8 8 0 0 1 8 8v54H235z',
  'M365 178a8 8 0 0 1 8-8h119a8 8 0 0 1 8 8v54H365z',
  'M100 232h400v50H100z',
];
const details = [
  'M110 222h115', 'M245 222h110', 'M375 222h115',
  'M40 282l-4 28h14l2-28', 'M560 282l4 28h-14l-2-28',
  'M128 282v20', 'M472 282v20',
  'M64 130v120', 'M536 130v120',
];
// Phone: numbered pins on the drawing with the legend below.
const pins = [
  { n: 1, x: 168, y: 202 },
  { n: 2, x: 300, y: 104 },
  { n: 3, x: 536, y: 196 },
];
// Leaders start at the legend, which sits above the drawing on wider screens, and land on the top contour.
const leaders = [
  { x: 160, y: 40, sx: 12 },
  { x: 300, y: 40, sx: 212 },
  { x: 460, y: 40, sx: 412 },
];
---
<figure class="scrub" data-scrub data-start={t.game.start} data-tap={t.game.tap} data-going={t.game.going} data-done={t.game.done} data-done-no-code={t.game.doneNoCode}>
  <div class="scrub__stage" aria-hidden="true">
    <svg class="scrub__fill" viewBox="0 0 600 340" preserveAspectRatio="xMidYMid meet">
      {shapes.map((d) => <path d={d} />)}
    </svg>
    <canvas class="scrub__dirt" data-scrub-canvas></canvas>
    <svg class="scrub__lines" viewBox="0 0 600 340" preserveAspectRatio="xMidYMid meet">
      <path class="scrub__floor" d="M8 312h584" />
      {shapes.map((d) => <path d={d} />)}
      {details.map((d) => <path class="scrub__detail" d={d} />)}
      {leaders.map((l) => (
        <g class="scrub__leader">
          <path d={`M${l.sx} 0L${l.x} ${l.y}`} />
          <circle cx={l.x} cy={l.y} r="5" />
        </g>
      ))}
      {pins.map((p) => (
        <g class="scrub__pin" transform={`translate(${p.x} ${p.y})`}>
          <circle r="15" />
          <text y="5.5" text-anchor="middle">{p.n}</text>
        </g>
      ))}
    </svg>
    <div class="scrub__stamp" data-scrub-stamp aria-hidden="true">
      <span class="scrub__stamp-ok">OK</span>
      <span class="scrub__stamp-off">−{promo.percent}%</span>
    </div>
    <svg class="scrub__tool" data-scrub-tool viewBox="-14 -150 92 162" width="92" height="162">
      <path d="M27 -150V-16M37 -150V-16M22 -16h20" />
      <path d="M0 0H64L57 -16H7Z" />
      <path d="M9 -5H55" />
    </svg>
  </div>
  <ol class="pins">
    {t.hero.pins.map(([title, text], i) => (
      <li><span class="pins__n" aria-hidden="true">{i + 1}</span><strong>{title}</strong> <span>{text}</span></li>
    ))}
  </ol>
  <p class="bubble" data-scrub-bubble role="status">{t.game.start}</p>
  <p class="visually-hidden">{t.hero.drawingLabel}</p>
  <figcaption class="game">
    <span class="game__label">{t.hero.clean}</span>
    <span class="game__track" aria-hidden="true">
      <span class="game__fill" data-scrub-fill></span>
      <span class="game__goal">{t.game.goal}</span>
    </span>
    <output class="game__pct" data-scrub-pct>0%</output>
    <a class="btn btn--ink game__use" href="#cena" data-scrub-use hidden>{t.game.use}</a>
    <button type="button" class="game__kbd" data-scrub-all>{t.game.keyboard}</button>
  </figcaption>
</figure>
